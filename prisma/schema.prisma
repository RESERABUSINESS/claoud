generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// المتجر
model Store {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  apiKey    String   @unique @default(cuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers    Offer[]
  customers Customer[]

  @@map("stores")
}

// العرض / الخصم
model Offer {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        OfferType
  value       Float     // نسبة أو مبلغ ثابت
  minOrderAmount Float? // الحد الأدنى للطلب
  maxDiscount    Float? // الحد الأقصى للخصم
  code        String?   // كود الخصم (اختياري)
  isActive    Boolean   @default(true)
  startsAt    DateTime
  endsAt      DateTime?
  conditions  Json?     // شروط إضافية
  usageLimit  Int?      // حد الاستخدام الكلي
  usageCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  redemptions Redemption[]

  @@index([storeId])
  @@index([code])
  @@map("offers")
}

// العميل
model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  phone     String?
  totalOrders Int    @default(0)
  totalSpent  Float  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions Redemption[]

  @@unique([storeId, email])
  @@index([storeId])
  @@map("customers")
}

// سجل استخدام العروض
model Redemption {
  id         String   @id @default(cuid())
  offerId    String
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderAmount Float
  discount    Float
  createdAt  DateTime @default(now())

  @@index([offerId])
  @@index([customerId])
  @@map("redemptions")
}

enum OfferType {
  PERCENTAGE  // نسبة مئوية
  FIXED       // مبلغ ثابت
  BUY_X_GET_Y // اشتري X واحصل على Y
  FREE_SHIPPING // شحن مجاني
}
