generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================
// المستخدم (Authentication)
// =============================================
model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  hashedPassword String
  image          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // علاقة المستخدم بالمتاجر (Multi-tenancy)
  storeUsers     StoreUser[]
  sessions       Session[]
  activityLogs   ActivityLog[]

  @@index([email])
  @@map("users")
}

// =============================================
// جلسة المستخدم
// =============================================
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

// =============================================
// ربط المستخدم بالمتجر (Multi-tenancy)
// =============================================
model StoreUser {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role      StoreRole @default(OWNER)
  createdAt DateTime  @default(now())

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
  @@map("store_users")
}

// =============================================
// سجل النشاطات
// =============================================
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // login, logout, password_change, store_connect, etc.
  details   String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([action])
  @@map("activity_logs")
}

// =============================================
// المتجر
// =============================================
model Store {
  id              String   @id @default(cuid())
  name            String
  platform        Platform
  apiKey          String   // مشفّر بـ AES
  apiSecret       String   // مشفّر بـ AES
  webhookUrl      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  storeUsers      StoreUser[]
  customers       Customer[]
  scenarios       Scenario[]
  coupons         Coupon[]

  @@index([platform])
  @@map("stores")
}

// =============================================
// العميل
// =============================================
model Customer {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  externalId    String        // معرّف العميل في المنصة الخارجية
  name          String?
  phone         String?
  email         String?
  totalOrders   Int           @default(0)
  totalSpent    Float         @default(0)
  lastOrderDate DateTime?
  birthday      DateTime?
  segment       CustomerSegment @default(NEW)
  createdAt     DateTime      @default(now())

  campaigns     Campaign[]

  @@unique([storeId, externalId])
  @@index([storeId])
  @@index([storeId, segment])
  @@index([email])
  @@index([phone])
  @@map("customers")
}

// =============================================
// السيناريو
// =============================================
model Scenario {
  id              String        @id @default(cuid())
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  type            ScenarioType
  isActive        Boolean       @default(true)
  trigger         Json          // شروط تفعيل السيناريو
  action          Json          // الإجراءات المطلوبة
  discountType    DiscountType
  discountValue   Float
  couponPrefix    String?       // بادئة الكوبون مثل "WELCOME"
  messageTemplate String        @db.Text // قالب الرسالة
  waitDuration    Int           @default(0) // مدة الانتظار بالدقائق
  channel         Channel       @default(WHATSAPP)
  createdAt       DateTime      @default(now())

  campaigns       Campaign[]

  @@index([storeId])
  @@index([storeId, type])
  @@index([storeId, isActive])
  @@map("scenarios")
}

// =============================================
// الحملة — كل مرة يتفعّل سيناريو لعميل
// =============================================
model Campaign {
  id          String         @id @default(cuid())
  scenarioId  String
  scenario    Scenario       @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  couponCode  String?
  status      CampaignStatus @default(PENDING)
  sentAt      DateTime?
  openedAt    DateTime?
  convertedAt DateTime?
  revenue     Float          @default(0)
  createdAt   DateTime       @default(now())

  coupon      Coupon?

  @@index([scenarioId])
  @@index([customerId])
  @@index([status])
  @@index([scenarioId, status])
  @@index([createdAt])
  @@map("campaigns")
}

// =============================================
// الكوبون
// =============================================
model Coupon {
  id            String       @id @default(cuid())
  storeId       String
  store         Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaignId    String       @unique
  campaign      Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  code          String
  discountType  DiscountType
  discountValue Float
  expiresAt     DateTime?
  isUsed        Boolean      @default(false)
  usedAt        DateTime?
  createdAt     DateTime     @default(now())

  @@unique([storeId, code])
  @@index([storeId])
  @@index([code])
  @@index([expiresAt])
  @@map("coupons")
}

// =============================================
// Enums
// =============================================

enum Platform {
  SALLA
  ZID
  SHOPIFY
}

enum CustomerSegment {
  NEW      // عميل جديد
  ACTIVE   // عميل نشط
  DORMANT  // عميل خامل
  VIP      // عميل مميز
}

enum ScenarioType {
  ABANDONED_CART // سلة متروكة
  DORMANT        // عميل خامل
  WELCOME        // ترحيب
  VIP            // عميل مميز
  BIRTHDAY       // عيد ميلاد
}

enum DiscountType {
  PERCENTAGE    // نسبة مئوية
  FIXED         // مبلغ ثابت
  FREE_SHIPPING // شحن مجاني
}

enum Channel {
  WHATSAPP
  SMS
  EMAIL
}

enum CampaignStatus {
  PENDING   // بانتظار الإرسال
  SENT      // تم الإرسال
  OPENED    // تم الفتح
  CONVERTED // تم التحويل (شراء)
  EXPIRED   // منتهي
}

enum StoreRole {
  OWNER   // مالك المتجر
  ADMIN   // مدير
  VIEWER  // مشاهد فقط
}
