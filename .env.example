# قاعدة البيانات
DATABASE_URL="postgresql://user:password@localhost:5432/smart_offers?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="عروض ذكية"

# مفتاح التشفير (استخدم قيمة عشوائية قوية)
SECRET_KEY="your-secret-key-here"

# مفتاح حماية الـ Cron Jobs (استخدم قيمة عشوائية قوية)
# في Vercel يتم إنشاؤه تلقائياً عند تفعيل Cron
CRON_SECRET="your-cron-secret-here"

# بيئة التشغيل
NODE_ENV="development"
