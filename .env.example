# قاعدة البيانات
DATABASE_URL="postgresql://user:password@localhost:5432/smart_offers?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="عروض ذكية"

# مفتاح التشفير (استخدم قيمة عشوائية قوية)
SECRET_KEY="your-secret-key-here"

# مفتاح حماية الـ Cron Jobs (استخدم قيمة عشوائية قوية)
# يُضاف كـ secret في Cloudflare Worker: wrangler secret put CRON_SECRET
CRON_SECRET="your-cron-secret-here"

# منصة سلة (Salla OAuth)
# احصل عليها من: https://salla.partners
SALLA_CLIENT_ID="your-salla-client-id"
SALLA_CLIENT_SECRET="your-salla-client-secret"
NEXT_PUBLIC_SALLA_CLIENT_ID="your-salla-client-id"
SALLA_WEBHOOK_SECRET="your-salla-webhook-secret"

# ──────────────────────────────────────────
# واتساب — اختر meta أو twilio
# ──────────────────────────────────────────
WHATSAPP_PROVIDER="meta"

# Meta WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-verify-token"
WHATSAPP_APP_SECRET=""

# Twilio (بديل)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="+14155238886"
TWILIO_SMS_FROM=""

# ──────────────────────────────────────────
# SMS — اختر unifonic أو twilio
# ──────────────────────────────────────────
SMS_PROVIDER="unifonic"
UNIFONIC_APP_SID=""
UNIFONIC_SENDER_ID="SmartOffers"

# ──────────────────────────────────────────
# إيميل — اختر resend أو smtp
# ──────────────────────────────────────────
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="offers@smartoffers.sa"

# بيئة التشغيل
NODE_ENV="development"
